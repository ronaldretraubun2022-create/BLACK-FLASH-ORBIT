{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web",
  "installCommand": "npm install",
  "functions": {
    "api/health.js": {
      "maxDuration": 10
    },
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
